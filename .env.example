ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_MB=50
MAX_AUDIO_DURATION_S=600
CORS_ORIGINS=*
WORKERS=1
RENDER_EXTERNAL_URL=

DATABASE_URL=postgresql://mach:mach@localhost:5432/mach
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=mach-audio-prod
S3_REGION=us-east-1

# Auth — JWT_SECRET is REQUIRED in production (>=32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
# Path to the local SQLite file holding users + subscriptions.
AUTH_DB_PATH=mach.db

# Billing (Stripe). Leave STRIPE_API_KEY empty to run billing in offline mode.
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
